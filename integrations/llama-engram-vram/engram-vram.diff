+// LLAMA_DSV41_ENGRAM_DEVICES: move the Engram table from the host (mmap / RAM) into device memory
+// the table can be larger than any single device, so it is cut into one piece per listed device
+// the cuts fall between hash heads: every head then gathers from exactly one piece
+void llama_model_deepseek41::post_load_tensors() {
+    const char * env = getenv("LLAMA_DSV41_ENGRAM_DEVICES");
+    if (!env || !*env || !per_layer_tok_embd || hparams.ple_n_heads == 0) {
+        return;
+    }
+
+    struct target {
+        ggml_backend_dev_t dev;
+        double             share;
+    };
+    std::vector<target> targets;
+    {
+        std::stringstream ss(env);
+        std::string item;
+        while (std::getline(ss, item, ',')) {
+            if (item.empty()) {
+                continue;
+            }
+            double share = 1.0;
+            const size_t colon = item.rfind(':');
+            if (colon != std::string::npos) {
+                share = atof(item.c_str() + colon + 1);
+                item.resize(colon);
+            }
+            ggml_backend_dev_t dev = ggml_backend_dev_by_name(item.c_str());
+            if (!dev || !(share > 0.0)) {
+                throw std::runtime_error(format("LLAMA_DSV41_ENGRAM_DEVICES: unknown device or bad share in '%s'", item.c_str()));
+            }
+            targets.push_back({ dev, share });
+        }
+    }
+    if (targets.empty()) {
+        return;
+    }
+
+    const ggml_tensor * src = per_layer_tok_embd;
+    const size_t row_bytes  = src->nb[1];
+    const size_t n_cols     = hparams.ple_n_heads;
+    const size_t n_all      = (size_t) hparams.ple_n_modules*n_cols;
+    const uint32_t * offs   = hparams.ple_head_offsets.data();
+    const uint32_t * primes = hparams.ple_head_vocab_sizes.data();
+
+    // heads in table order; pieces are runs of this order
+    std::vector<size_t> order(n_all);
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) { return offs[a] < offs[b]; });
+    uint64_t n_used = 0;
+    for (size_t i = 0; i < n_all; ++i) {
+        const size_t c = order[i];
+        if (i + 1 < n_all && (uint64_t) offs[c] + primes[c] > offs[order[i + 1]]) {
+            throw std::runtime_error("LLAMA_DSV41_ENGRAM_DEVICES: the Engram heads share table rows, so the table cannot be cut");
+        }
+        n_used += primes[c];
+    }
+
+    double share_sum = 0.0;
+    for (const auto & t : targets) {
+        share_sum += t.share;
+    }
+
+    // head i goes to the first piece whose cumulative share covers the middle of the head
+    std::vector<int> piece_of(n_all, -1);
+    struct range {
+        int64_t row0 = -1;
+        int64_t row1 = -1;
+        ggml_backend_dev_t dev = nullptr;
+    };
+    std::vector<range> ranges;
+    {
+        size_t   it      = 0;
+        double   cum     = targets[0].share;
+        uint64_t acc     = 0;
+        int      cur     = -1; // index in ranges of the piece of target it
+        for (size_t i = 0; i < n_all; ++i) {
+            const size_t c   = order[i];
+            const double mid = (double) acc + 0.5*primes[c];
+            while (it + 1 < targets.size() && mid >= (double) n_used*cum/share_sum) {
+                cum += targets[++it].share;
+                cur = -1;
+            }
+            if (cur < 0) {
+                cur = (int) ranges.size();
+                ranges.push_back({ (int64_t) offs[c], 0, targets[it].dev });
+            }
+            ranges[cur].row1 = (int64_t) offs[c] + primes[c];
+            piece_of[c] = cur;
+            acc += primes[c];
+        }
+    }
+
+    engram_pieces.clear();
+    engram_groups.assign(hparams.ple_n_modules, {});
+
+    std::vector<uint8_t> tmp;
+    for (size_t p = 0; p < ranges.size(); ++p) {
+        const auto & r = ranges[p];
+        const int64_t n_rows = r.row1 - r.row0;
+        GGML_ASSERT(r.row0 >= 0 && n_rows > 0 && r.row1 <= src->ne[1]);
+
+        ggml_init_params ip = {
+            /*.mem_size   =*/ ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx { ggml_init(ip) };
+        if (!ctx) {
+            throw std::runtime_error("failed to create the Engram piece context");
+        }
+        ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), src->type, src->ne[0], n_rows);
+        ggml_format_name(t, "%s.piece%zu", src->name, p);
+        GGML_ASSERT(t->nb[1] == row_bytes);
+
+        const size_t n_bytes = (size_t) n_rows*row_bytes;
+        LLAMA_LOG_INFO("%s: Engram piece %zu: rows [%" PRId64 ", %" PRId64 ") = %.2f GiB -> %s\n", __func__, p, r.row0, r.row1,
+                n_bytes/1024.0/1024.0/1024.0, ggml_backend_dev_name(r.dev));
+
+        adopt_weights(std::move(ctx), ggml_backend_dev_buffer_type(r.dev));
+
+        if (!params.no_alloc) {
+            // streamed: the source may be a lazily mapped file much larger than the host RAM
+            const bool   host = src->data && src->buffer && ggml_backend_buffer_is_host(src->buffer);
+            const size_t base = (size_t) r.row0*row_bytes;
+            const size_t step = 64ull*1024*1024;
+            const int64_t t0  = ggml_time_us();
+            for (size_t o = 0; o < n_bytes; o += step) {
+                const size_t n = std::min(step, n_bytes - o);
+                if (host) {
+                    ggml_backend_tensor_set(t, (const char *) src->data + base + o, o, n);
+                } else {
+                    tmp.resize(n);
+                    ggml_backend_tensor_get(src, tmp.data(), base + o, n);
+                    ggml_backend_tensor_set(t, tmp.data(), o, n);
+                }
+            }
+            LLAMA_LOG_INFO("%s: Engram piece %zu copied in %.1f s\n", __func__, p, (ggml_time_us() - t0)/1e6);
+        }
+
+        engram_pieces.push_back({ t, r.row0 });
+    }
+
+    for (size_t e = 0; e < hparams.ple_n_modules; ++e) {
+        auto & groups = engram_groups[e];
+        for (size_t col = 0; col < n_cols; ++col) {
+            const int p = piece_of[e*n_cols + col];
+            if (groups.empty() || groups.back().piece != p) {
+                groups.push_back({ p, (int) col, 1 });
+            } else {
+                groups.back().n_cols++;
+            }
+        }
+    }
+
+    // the host copy is no longer read
+    can_prefetch.erase(per_layer_tok_embd);
+}
